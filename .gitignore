/target
/runs
__pycache__/
.DS_Store

# spike/ was deleted at M7; its record is the tag `spike-final`. Private material stays on disk in
# these three folders, outside git (CONTRIBUTING.md); xtask's private-name check reads its
# patterns from spike/local/ and never searches the three.
/spike/local/
/spike/out/
/spike/build/

# Python environments of the conformance runner and the SDK (uv).
tools/conformance/.venv/
sdk/python/.venv/

# Build outputs beside a world file: the store (graph.md 3.2, build.md 13: `.via/store/`) and the
# default build directory (build.md 14: `--out` defaults to `build/<name>` beside the world file).
# Anchored to where world files live, so a spec folder named after the build chapter
# (spec/vectors/build/) stays tracked.
.via/
/examples/**/build/
/spec/vectors/*/**/build/
